OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
LANDSLIDE_REFRESH_HOURS=6
HTTP_TIMEOUT_SECONDS=30

# SMS via Android Gateway local mode. Keep live sending disabled until the
# phone is reachable and the dry-run payload has been checked.
SMS_BRAND_NAME=TRAM BAN
SMS_PROVIDER=android
ANDROID_SMS_GATEWAY_URL=http://192.168.1.100:8080/message
ANDROID_SMS_GATEWAY_USERNAME=
ANDROID_SMS_GATEWAY_PASSWORD=
SMS_LIVE_SEND_ENABLED=false
DELIVERY_API_KEY=replace-with-a-long-random-secret
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER_ID=
