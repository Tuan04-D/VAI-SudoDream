LLM_PROVIDER=DEEPSEEK
LLM_API_KEY=
LLM_MODEL=

APP_ENV=development
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true
WARMUP_ENABLED=true
CACHE_DIR=

KAGGLE_NGROK_URL=

DEFAULT_COMMUNE_ID=19571213
NOTIFY_HOUR=7
NOTIFY_MINUTE=0
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas URI (or another MongoDB deployment).
MONGO_URI=mongodb+srv://<app-user>:<url-encoded-password>@<cluster>/?retryWrites=true&w=majority
MONGO_DB_NAME=tramban
MONGO_CONNECT_TIMEOUT_MS=5000

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=tramban_refresh
COOKIE_SECURE=false
ALLOW_OFFICIAL_SELF_REGISTRATION=false

# Set only for the first startup, then remove the plaintext password.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Quản trị hệ thống

# SMS is deferred and disabled by default.
SMS_ENABLED=false
SMS_SERVICE_URL=http://127.0.0.1:8001/api/v1/delivery/sms
SMS_DELIVERY_API_KEY=
SMS_MAX_ATTEMPTS=5
SMS_WORKER_SECONDS=30

WEATHER_CACHE_MINUTES=30
LANDSLIDE_CACHE_MINUTES=10
ADVISORY_CACHE_MINUTES=20
LANDSLIDE_REFRESH_HOURS=6
HTTP_TIMEOUT_SECONDS=30
