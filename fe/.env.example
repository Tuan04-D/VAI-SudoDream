# Khuyến nghị dùng proxy cùng domain để refresh-cookie hoạt động ổn định.
NEXT_PUBLIC_API_BASE=/backend
API_SERVER_BASE=http://localhost:8000
API_PROXY_TARGET=http://localhost:8000
# Tuỳ chọn. Nếu bỏ trống, frontend tự lấy WebSocket URL từ API_PROXY_TARGET.
# NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Vercel production (replace with the deployed backend URL):
# NEXT_PUBLIC_API_BASE=/backend
# API_SERVER_BASE=https://your-backend.onrender.com
# API_PROXY_TARGET=https://your-backend.onrender.com
# NEXT_PUBLIC_WS_BASE=wss://your-backend.onrender.com
